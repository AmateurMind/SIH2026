# Backend Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to version control.

NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=

# URLs
FRONTEND_URL=https://<your-frontend-url>
SUPERADMIN_URL=https://<your-superadmin-url>

# Authentication
JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_LEGACY_JWT_AUDIENCE=
CLERK_LEGACY_JWT_TEMPLATE_NAME=
CLERK_NEW_JWT_TEMPLATE_NAME=
CLERK_NEW_JWT_AUDIENCE=
CLERK_JWT_ISSUER=

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# AI services
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Web3Forms (email service)
WEB3FORMS_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_MENTOR_CHAT_ID=

# External integrations API key (used for n8n webhooks, etc.)
EXTERNAL_API_KEY=

# n8n webhook URL
N8N_MENTOR_WEBHOOK_URL=

# Algorand Blockchain Certificate Configuration
# ------------------------------------------------
# Network: 'testnet' for testing, 'mainnet' for production
ALGORAND_NETWORK=testnet

# Issuer Wallet Mnemonic (25 words) - REQUIRED for blockchain certificates
# Generate using: POST /api/verify/generate-wallet
# OR create in Pera Wallet and export mnemonic
# WARNING: Keep this secure! Never commit to git!
ALGORAND_ISSUER_MNEMONIC=

# Optional: Custom Algorand Node Configuration
# Defaults to AlgoNode free tier if not specified
# ALGOD_SERVER=https://testnet-api.algonode.cloud
# ALGOD_PORT=
# ALGOD_TOKEN=
# INDEXER_SERVER=https://testnet-idx.algonode.cloud

