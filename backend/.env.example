# Backend Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to version control.

NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=

# URLs
FRONTEND_URL=https://<your-frontend-url>
SUPERADMIN_URL=https://<your-superadmin-url>

# Authentication
JWT_SECRET=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_LEGACY_JWT_AUDIENCE=
CLERK_LEGACY_JWT_TEMPLATE_NAME=
CLERK_NEW_JWT_TEMPLATE_NAME=
CLERK_NEW_JWT_AUDIENCE=
CLERK_JWT_ISSUER=

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# AI services
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Web3Forms (email service)
WEB3FORMS_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_MENTOR_CHAT_ID=

# External integrations API key (used for n8n webhooks, etc.)
EXTERNAL_API_KEY=

# n8n webhook URL
N8N_MENTOR_WEBHOOK_URL=
